    "ts-type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@geajs/core": "^1.4.0",
    "@geajs/ui": "^0.2.9"
  },
  "devDependencies": {
    "@geajs/core": "^1.4.0",
    "@geajs/ui": "^0.2.9",
    "@geajs/vite-plugin": "^1.4.1",
    "esbuild": "^0.28.0",
    "jsdom": "^29.0.0",
    "tsdown": "^0.21.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
