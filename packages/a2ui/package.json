{
  "name": "@geajs/a2ui",
  "version": "0.1.0",
  "description": "A2UI v0.9.1 renderer for Gea",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": ["dist"],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
